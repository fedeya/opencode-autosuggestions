{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-autosuggestions",
  "version": "0.1.7",
  "description": "Copilot-style prompt autosuggestions for the OpenCode TUI: the likely next prompt after each turn, and completions while you type",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "autosuggestions",
    "autocomplete",
    "tui"
  ],
  "author": "Federico Minaya <hello@fedeminaya.com>",
  "license": "MIT",
  "homepage": "https://github.com/fedeya/opencode-autosuggestions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedeya/opencode-autosuggestions.git"
  },
  "bugs": {
    "url": "https://github.com/fedeya/opencode-autosuggestions/issues"
  },
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build && cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@autosuggestions/core": "workspace:*",
    "@opencode/client": "^2.3.0",
    "@opentui/core": "^0.9.2",
    "@opentui/solid": "^0.9.2",
    "solid-js": "^1.9.19"
  }
}
