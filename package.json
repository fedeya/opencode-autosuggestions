{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "autosuggestions-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "tsc --noEmit && biome check . && bun test",
    "eval": "bun eval/run.ts",
    "eval:compare": "bun eval/compare.ts"
  },
  "devDependencies": {
    "@autosuggestions/core": "workspace:*",
    "@biomejs/biome": "^2.6.8",
    "@opencode/client": "^2.3.0",
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.0"
  }
}
